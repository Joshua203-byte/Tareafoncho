# Copia este archivo a `.env` (que está en .gitignore) y pon tu token de desarrollo.
# Nunca escribas el token real en este archivo ni en el código.
#
# Token de desarrollo: el que distribuye el instructor en la guía (sección VIII).
# El token del día de la presentación se pondrá en la misma variable.
QA_API_TOKEN=pon-aqui-tu-token-de-desarrollo

# Configuración del servicio (valores por defecto en service/config.py)
QA_MODEL_DIR=models/best
QA_PORT=8000
